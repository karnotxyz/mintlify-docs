{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "ArcX",
  "description": "ArcX wraps perp DEX strategies into a vault token that earns yield and credits for supported reward programs. Split into ST and EPT for isolated exposure.",
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/arc-logo.png",
    "dark": "/logo/arc-logo.png",
    "href": "https://arcx.trade"
  },
  "colors": {
    "primary": "#40C873",
    "light": "#4DD88A",
    "dark": "#40C873"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0A0A0A"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "mermaid": {},
  "styling": {
    "eyebrows": "breadcrumbs",
    "latex": true,
    "codeblocks": "dark"
  },
  "navbar": {
    "links": [
      {
        "label": "Twitter",
        "href": "https://x.com/arcxtrade"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://app.arcx.trade"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Learn",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "learn/protocol-overview",
              "learn/series-lifecycle",
              "learn/trust-model-and-security",
              "learn/audits"
            ]
          },
          {
            "group": "Tokens",
            "pages": [
              "learn/vtoken",
              "learn/strategy-token",
              "learn/expected-points-token",
              "learn/credit-token"
            ]
          },
          {
            "group": "Using ArcX",
            "pages": [
              "learn/user-guide",
              "learn/orderbook-guide",
              "learn/pendle-comparison"
            ]
          },
          {
            "group": "Legal",
            "pages": [
              "legal/risk-disclosure",
              "legal/restricted-jurisdictions",
              "legal/terms-of-use"
            ]
          }
        ]
      },
      {
        "tab": "Deep Dives",
        "groups": [
          {
            "group": "Technical Analysis",
            "pages": [
              "deep-dives/credit-mathematics",
              "deep-dives/orderbook-mechanics",
              "deep-dives/ept-pricing"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/glossary-and-reference"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/arcxtrade"
    }
  }
}
